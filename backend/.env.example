# Database configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dssat_rag
POSTGRES_SCHEMA=public

# Qdrant configuration (optional)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# OpenAI settings (required for chat)
# Set these so planner and response generator use the same credentials
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# Application settings
APP_NAME="DSSAT RAG Backend"
APP_VERSION="1.0.0"
DEBUG=False

# Spatial filtering (radius used when a question or map point gives none)
SPATIAL_DEFAULT_RADIUS_KM=25
SPATIAL_MAX_RADIUS_KM=500

# Place lookup via OpenStreetMap Nominatim (free; no API key).
# The public server requires a User-Agent identifying your app with a contact
# (e.g. "DSSAT-RAG/1.0 (you@example.org)") and max 1 request/second.
# Point GEOCODER_URL at a self-hosted Nominatim for heavier use.
GEOCODER_ENABLED=True
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=
GEOCODER_TIMEOUT_SECONDS=10
